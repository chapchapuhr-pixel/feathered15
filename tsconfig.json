{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "AppRouter.tsx",
    "index.tsx",
    "config.ts",
    "constants.ts",
    "firebase.ts",
    "postActionRegistry.ts",
    "types.ts",
    "env.d.ts",
    "native.d.ts",
    "components/**/*",
    "contexts/**/*",
    "hooks/**/*",
    "types/**/*",
    "utils/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "functions",
    "public",
    "server.cjs"
  ]
}